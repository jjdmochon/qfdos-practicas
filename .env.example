# =============================================================
# Prácticas v4 — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NO se sube a Git (está en .gitignore).
# =============================================================

# Google OAuth 2.0 Client ID.
# Solo se necesita para el botón «Entrar»: sin él la aplicación funciona
# igual, pero no se pueden enviar entregas ni ver «Mi progreso».
#
# Crea el Client ID con una cuenta PERSONAL de Gmail: Google Workspace no
# permite crear proyectos OAuth desde cuentas administradas (@ugr.es).
#   1. https://console.cloud.google.com/ → proyecto nuevo
#   2. APIs & Services → Credentials → OAuth 2.0 Client ID → Web application
#   3. Orígenes autorizados (Authorized JavaScript origins). Esta app corre en
#      un origen distinto del de la plataforma principal, así que hay que dar
#      de alta los suyos o Google contesta origin_mismatch:
#         http://localhost:3002
#         https://jjdmochon.github.io
#
# Se usa el mismo Client ID que QFDOS: las reglas de acceso son las mismas
# (cuentas de la UGR; Gmail admitido pero marcado como externo; el papel de
# profesor exige cuenta institucional).
VITE_GOOGLE_CLIENT_ID=

# Recepción de entregas en Google Sheets (Apps Script desplegado como Web App).
# Pega aquí la URL que termina en /exec. Sin esto, la aplicación ofrece el
# envío por correo como alternativa.
VITE_PRACTICAS_WEBAPP_URL=
